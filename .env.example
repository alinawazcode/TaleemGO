# TaleemGo AI .env.example — copy to .env and fill in your values

# --- Supabase / LMS (required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
LMS_BASE_URL=https://your-lms-site.vercel.app

# --- WhatsApp bridge ---
BRIDGE_TOKEN=change_this_to_a_random_secret
BRIDGE_PORT=3001
BRIDGE_URL=http://127.0.0.1:3001
PY_WEBHOOK=http://127.0.0.1:8000/incoming
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Bot settings ---
MONITOR_INTERVAL_MINUTES=30
MAX_USERS=5
ACTIVATION_PHRASES=taleemgo ai,taleem go ai,taleemgo
ATTENDANCE_WARN=75
DIGEST_DEFAULT_TIME=07:30
TIMEZONE=Asia/Karachi

# --- Encryption (auto-generated on first run if absent) ---
TALEEMGO_SECRET_KEY=
# SATHI_SECRET_KEY=  # Deprecated: use TALEEMGO_SECRET_KEY

# --- Admin / testing ---
# Your own WhatsApp number for self-chat testing (optional)
ADMIN_NUMBER=
DEBUG_SELF=0

# --- Natural Language / LLM (TaleemGo AI) ---
LLM_ENABLED=1
LLM_PROVIDERS=gemini,groq

# Feature Chains (independent failover per capability)
INTENT_PROVIDERS=gemini,groq
STUDY_PROVIDERS=gemini,groq
STT_PROVIDERS=groq,gemini

# Exhibition & Concurrency Controls
EXHIBITION_MODE=0
PROVIDER_CONCURRENCY=3

# Free API keys (Google AI Studio, Groq, Mistral, Cloudflare)
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional extras:
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
# Local LLM (Ollama or OpenAI-compatible server; no key required)
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_KEY=

# Model IDs (ordered lists tried in order; verified 2026-11-15)
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.6-flash
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
MISTRAL_MODELS=mistral-small-latest,open-mistral-7b
CLOUDFLARE_MODELS=@cf/meta/llama-3.1-8b-instruct,@cf/meta/llama-3-8b-instruct
LOCAL_LLM_MODELS=llama3.2:3b,qwen2.5:3b
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free
# CEREBRAS_MODELS=llama3.1-8b

# Provider Rate Limit Ceilings (override defaults if needed)
# GROQ_RPM=30
# GROQ_TPM=8000
# GROQ_RPD=1000
# GROQ_TPD=200000
# GEMINI_RPM=15
# GEMINI_TPM=1000000
# GEMINI_RPD=1500
# OPENROUTER_RPM=20
# OPENROUTER_RPD=50

# LLM Rate Limiting & Off-topic Lockout Policy
LLM_USER_LIMIT_PER_HOUR=20
LLM_STRIKES=2
LLM_STRIKE_WINDOW_MIN=10
LLM_LOCK_HOURS=2
LLM_NOTIFY_ON_LOCK=1
LLM_ADMIN_EXEMPT=1
GREETING_REPLY=1
LLM_HELP_REPLY_INTERVAL_MIN=2

# --- Voice notes (STT) ---
STT_PROVIDERS=groq,gemini
GROQ_STT_MODELS=whisper-large-v3-turbo,whisper-large-v3
GEMINI_STT_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.6-flash
VOICE_MAX_SECONDS=30
VOICE_MAX_BYTES=2000000
VOICE_LIMIT_PER_HOUR=10

# --- Study Helper (Summaries & Quizzes) ---
STUDY_LIMIT_PER_HOUR=6
STUDY_MAX_PAGES=20
STUDY_MAX_CHARS=24000
STUDY_MAX_FILE_BYTES=20000000

# --- Legacy Telegram bot only (not needed for WhatsApp multi-user) ---
# LMS_EMAIL=your@email.com
# LMS_PASSWORD=yourpassword
