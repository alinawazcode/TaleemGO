# TaleemGo AI Production Environment Configuration
# Template for Azure Ubuntu VM deployment.
# Generated /opt/taleemgo/.env must be chmod 600 and owned by user 'taleemgo'.

# --- Supabase / LMS (required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
LMS_BASE_URL=https://your-lms-site.vercel.app

# --- WhatsApp Bridge & Python Webhook ---
# Auto-generated by deploy/setup.sh via: openssl rand -hex 32
BRIDGE_TOKEN=
BRIDGE_PORT=3001
BRIDGE_URL=http://127.0.0.1:3001
PY_WEBHOOK=http://127.0.0.1:8000/incoming
CHROME_PATH=/usr/bin/google-chrome-stable

# --- Bot Settings ---
MONITOR_INTERVAL_MINUTES=30
MAX_USERS=5
ACTIVATION_PHRASES=taleemgo ai,talimgo ai,taleem go ai,talim go ai
ATTENDANCE_WARN=75

# --- Encryption ---
# Auto-generated by deploy/setup.sh via Fernet.generate_key()
TALEEMGO_SECRET_KEY=

# --- Admin / Self-Chat Testing (optional) ---
# Your WhatsApp number including country code without + or spaces (e.g. 923001234567)
ADMIN_NUMBER=
# Auto-detected on first message; manual override if self-chat LID is known:
ADMIN_LID=
DEBUG_SELF=0

# --- Natural Language / LLM (TaleemGo AI) ---
LLM_ENABLED=1
LLM_PROVIDERS=gemini,groq

# Free API keys (Google AI Studio, Groq)
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional extras:
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Verified model lists (tried in order; verified 2026-11-08)
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.6-flash
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

# LLM Rate Limiting & Off-topic Policy
LLM_USER_LIMIT_PER_HOUR=20
LLM_STRIKES_BEFORE_LOCK=4
LLM_LOCK_HOURS=2
LLM_NOTIFY_ON_LOCK=1
LLM_ADMIN_EXEMPT=1
GREETING_REPLY=1
LLM_HELP_REPLY_INTERVAL_MIN=2

